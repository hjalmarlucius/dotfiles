#!/usr/bin/env python3.14
"""
catai: Collect files in XML tags for LLM context.

Requires Python >= 3.14 (PEP 649/749 deferred annotations, PEP 695 type statements).
"""

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

type GlobList = list[str]
type PathList = list[str]

DEFAULT_IGNORES: tuple[str, ...] = (
    "!.git/*",
    "!.env*",
    "!*lock*",
    "!*.lock",
    "!*.min.*",
)

EXAMPLES = """
Examples:
  catai                                       # Dump entire current repo
  catai src/                                  # Dump everything inside src/
  catai packages/**/*.py -x packages/**/vega.py
  catai src -x legacy                         # Everything in src/ except src/legacy/
  catai src -x '*.test.ts' -x dist            # Exclude multiple patterns
  catai src '!legacy' '!*.spec.js'            # Exclude using '!' shorthand
  catai -i src -x vendor                      # Pick files in fzf
  catai -y                                    # Pick files/folders in Yazi
  catai -d                                    # Only git-modified & untracked files
"""


@dataclass(slots=True, frozen=True)
class Config:
    paths: PathList
    rg_globs: GlobList
    dirty: bool
    interactive: bool
    yazi: bool
    print_cmd: bool


def is_glob(pattern: str) -> bool:
    """Return True if the string contains glob metacharacters."""
    return any(ch in pattern for ch in ("*", "?", "["))


def normalize_rel(raw: str) -> str:
    """Normalize a path or glob relative to CWD without resolving symlinks on globs."""
    clean = raw.rstrip("/")
    if not clean:
        return "."
    if is_glob(clean):
        return clean.removeprefix("./")
    try:
        resolved = Path(clean).resolve()
        cwd = Path.cwd().resolve()
        rel = str(resolved.relative_to(cwd))
        return "." if rel == "" else rel
    except ValueError:
        return os.path.relpath(clean, Path.cwd())


def expand_include_glob(pattern: str) -> GlobList:
    """Convert an include glob (e.g. packages/**/*.py) into ripgrep glob flags."""
    clean = normalize_rel(pattern)
    if clean.endswith("/**") or clean.endswith("/*"):
        return [f"--glob={clean}"]
    return (
        [f"--glob={clean}", f"--glob=**/{clean}"]
        if "/" not in clean
        else [f"--glob={clean}"]
    )


def expand_exclude(pattern: str) -> GlobList:
    """Expand a user exclusion pattern into ripgrep glob flags."""
    clean = pattern.lstrip("!").rstrip("/")
    if not clean:
        return []
    clean = normalize_rel(clean)

    # If the pattern already contains ** or *, pass both direct and nested negative globs
    if is_glob(clean):
        if "/" in clean:
            return [f"--glob=!{clean}", f"--glob=!{clean}/**"]
        return [
            f"--glob=!{clean}",
            f"--glob=!{clean}/**",
            f"--glob=!**/{clean}",
            f"--glob=!**/{clean}/**",
        ]

    return [
        f"--glob=!{clean}",
        f"--glob=!{clean}/**",
        f"--glob=!**/{clean}",
        f"--glob=!**/{clean}/**",
    ]


def parse_args(argv: Sequence[str] | None = None) -> Config:
    parser = argparse.ArgumentParser(
        prog="catai",
        description="Collect files in XML tags for LLM context.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "targets",
        nargs="*",
        help="Files, directories, globs, or '!exclude' globs",
    )
    parser.add_argument(
        "-x",
        "--exclude",
        action="append",
        default=[],
        metavar="PATTERN",
        help="Exclude folder or file glob (repeatable)",
    )
    parser.add_argument(
        "-d",
        "--dirty",
        action="store_true",
        help="Only git modified & untracked files",
    )
    parser.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="Interactive fzf file picker",
    )
    parser.add_argument(
        "-y",
        "--yazi",
        action="store_true",
        help="Interactive Yazi file/folder chooser",
    )
    parser.add_argument(
        "--print-cmd",
        action="store_true",
        help="Print selected command instead of executing (used by zsh print -z)",
    )

    ns = parser.parse_args(argv)

    include_globs: GlobList = []
    exclude_globs: GlobList = [f"--glob={g}" for g in DEFAULT_IGNORES]

    for ex in ns.exclude:
        exclude_globs.extend(expand_exclude(ex))

    paths: PathList = []
    for target in ns.targets:
        match target:
            case s if s.startswith("!"):
                exclude_globs.extend(expand_exclude(s[1:]))
            case s if is_glob(s):
                include_globs.extend(expand_include_glob(s))
            case s:
                paths.append(s)

    # Include globs must come BEFORE exclude globs so exclusions win in ripgrep
    rg_globs: GlobList = [*include_globs, *exclude_globs]

    return Config(
        paths=paths,
        rg_globs=rg_globs,
        dirty=ns.dirty,
        interactive=ns.interactive,
        yazi=ns.yazi,
        print_cmd=ns.print_cmd,
    )


def run_lines(cmd: Sequence[str]) -> list[str]:
    """Run a command and return non-empty stdout lines."""
    res = subprocess.run(cmd, capture_output=True, text=True, check=False)
    return [line for line in res.stdout.splitlines() if line]


def pick_with_fzf(cfg: Config) -> PathList:
    rg_cmd = [
        "rg",
        "--files",
        "--hidden",
        "--sort",
        "path",
        *cfg.rg_globs,
        "--",
        *cfg.paths,
    ]
    all_files = run_lines(rg_cmd)
    if not all_files:
        return []

    preview = "bat --color=always {} 2>/dev/null || cat {}"
    proc = subprocess.run(
        ["fzf", "-m", "--preview", preview],
        input="\n".join(all_files),
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    return [line for line in proc.stdout.splitlines() if line]


def pick_with_yazi(cfg: Config) -> PathList:
    with tempfile.NamedTemporaryFile(prefix="yazi-chooser.", delete=False) as tmp:
        tmp_path = Path(tmp.name)

    try:
        subprocess.run(["yazi", f"--chooser-file={tmp_path}", *cfg.paths], check=False)
        if not tmp_path.exists() or tmp_path.stat().st_size == 0:
            return []
        raw_picked = [
            line for line in tmp_path.read_text(encoding="utf-8").splitlines() if line
        ]
        return [normalize_rel(p) for p in raw_picked]
    finally:
        tmp_path.unlink(missing_ok=True)


def collect_files(cfg: Config, target_paths: PathList) -> PathList:
    """Return matched non-empty text files while strictly respecting .gitignore and -x."""
    rel_targets = [normalize_rel(p) for p in target_paths]

    # Separate directory targets from explicit file targets.
    # Because ripgrep ignores .gitignore and --glob when given explicit file paths,
    # we always validate explicit files against `rg --files` in the repo.
    dirs: PathList = []
    explicit_files: set[str] = set()

    for t in rel_targets:
        p = Path(t)
        if p.is_dir():
            dirs.append(t)
        elif p.is_file():
            explicit_files.add(t)
        else:
            dirs.append(t)

    if cfg.dirty:
        dirty_cmd = [
            "git",
            "ls-files",
            "-m",
            "-o",
            "--exclude-standard",
            "--",
            *rel_targets,
        ]
        dirty_files = set(run_lines(dirty_cmd))
        if not dirty_files:
            return []
        allowed_all = set(
            run_lines(["rg", "--files", "--hidden", "--sort", "path", *cfg.rg_globs])
        )
        candidates = sorted(dirty_files & allowed_all)
        if not candidates:
            return []
    elif explicit_files:
        # Intersect explicit files with ripgrep's allowed file list so .gitignore and -x win
        allowed_all = set(
            run_lines(["rg", "--files", "--hidden", "--sort", "path", *cfg.rg_globs])
        )
        valid_files = sorted(explicit_files & allowed_all)
        dir_files = (
            run_lines(
                [
                    "rg",
                    "--files",
                    "--hidden",
                    "--sort",
                    "path",
                    *cfg.rg_globs,
                    "--",
                    *dirs,
                ]
            )
            if dirs
            else []
        )
        candidates = sorted(set(valid_files) | set(dir_files))
        if not candidates:
            return []
    else:
        candidates = dirs

    # Non-empty, non-binary check via ripgrep '^'
    rg_content_cmd = [
        "rg",
        "-l",
        "--hidden",
        "--sort",
        "path",
        *([] if (cfg.dirty or explicit_files) else cfg.rg_globs),
        "^",
        "--",
        *candidates,
    ]
    return run_lines(rg_content_cmd)


def dump_output(files: PathList) -> None:
    out = sys.stdout
    for filepath in files:
        path = Path(filepath)
        out.write(f'<file path="{filepath}">\n')
        out.flush()
        try:
            with path.open("rb") as f:
                shutil.copyfileobj(f, sys.stdout.buffer)
            # Ensure trailing newline before closing tag
            if path.stat().st_size > 0:
                with path.open("rb") as f:
                    f.seek(-1, os.SEEK_END)
                    if f.read(1) != b"\n":
                        out.write("\n")
        except OSError as exc:
            sys.stderr.write(f"Error reading {filepath}: {exc}\n")
        out.write("</file>\n\n")


def main() -> int:
    cfg = parse_args()

    # Handle interactive pickers (-i / -y)
    if cfg.interactive or cfg.yazi:
        picked = pick_with_yazi(cfg) if cfg.yazi else pick_with_fzf(cfg)
        if not picked:
            return 1
        if cfg.print_cmd:
            print(f"catai {shlex.join(picked)}")
            return 0
        files = collect_files(cfg, picked)
    else:
        files = collect_files(cfg, cfg.paths)

    if not files:
        msg = (
            "No dirty or untracked files found."
            if cfg.dirty
            else "No matching text files found."
        )
        sys.stderr.write(f"{msg}\n")
        return 1

    dump_output(files)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
