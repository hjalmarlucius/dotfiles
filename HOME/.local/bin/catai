#!/usr/bin/env python3.14
"""
catai: Collect files in XML tags for LLM context.

Requires Python >= 3.14 (PEP 649/749 deferred annotations, PEP 695 type statements).
"""

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

type GlobList = list[str]
type PathList = list[str]

DEFAULT_IGNORES: tuple[str, ...] = (
    "!.git/*",
    "!.env*",
    "!*lock*",
    "!*.lock",
    "!*.min.*",
)

EXAMPLES = """
Examples:
  catai                                       # Dump entire current repo
  catai src/                                  # Dump everything inside src/
  catai packages/**/*.py gists/frontend.py    # Mix globs and explicit files freely
  catai packages/**/*.py -x packages/**/vega.py
  catai src -x legacy                         # Everything in src/ except src/legacy/
  catai src -x '*.test.ts' -x dist            # Exclude multiple patterns
  catai src '!legacy' '!*.spec.js'            # Exclude using '!' shorthand
  catai -i src -x vendor                      # Pick files in fzf
  catai -y                                    # Pick files/folders in Yazi
  catai -d                                    # Only git-modified & untracked files
"""


@dataclass(slots=True, frozen=True)
class Config:
    targets: PathList
    exclude_globs: GlobList
    dirty: bool
    interactive: bool
    yazi: bool
    print_cmd: bool


def is_glob(pattern: str) -> bool:
    """Return True if the string contains glob metacharacters."""
    return any(ch in pattern for ch in ("*", "?", "["))


def normalize_rel(raw: str) -> str:
    """Normalize a path or glob relative to CWD without resolving symlinks on globs."""
    while raw.startswith("./"):
        raw = raw[2:]
    clean = raw.rstrip("/")
    if not clean:
        return "."
    if is_glob(clean):
        return clean
    try:
        resolved = Path(clean).resolve()
        cwd = Path.cwd().resolve()
        rel = str(resolved.relative_to(cwd))
        return "." if rel == "" else rel
    except ValueError:
        return os.path.relpath(clean, Path.cwd())


def expand_include_glob(pattern: str) -> GlobList:
    """Convert an include glob (e.g. packages/**/*.py) into ripgrep glob flags."""
    clean = normalize_rel(pattern)
    if clean.endswith("/**") or clean.endswith("/*"):
        return [f"--glob={clean}"]
    return (
        [f"--glob={clean}", f"--glob=**/{clean}"]
        if "/" not in clean
        else [f"--glob={clean}"]
    )


def expand_exclude(pattern: str) -> GlobList:
    """Expand a user exclusion pattern into ripgrep glob flags."""
    clean = pattern.lstrip("!").rstrip("/")
    if not clean:
        return []
    clean = normalize_rel(clean)

    if is_glob(clean) and "/" in clean:
        return [f"--glob=!{clean}", f"--glob=!{clean}/**"]

    return [
        f"--glob=!{clean}",
        f"--glob=!{clean}/**",
        f"--glob=!**/{clean}",
        f"--glob=!**/{clean}/**",
    ]


def parse_args(argv: Sequence[str] | None = None) -> Config:
    parser = argparse.ArgumentParser(
        prog="catai",
        description="Collect files in XML tags for LLM context.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "targets",
        nargs="*",
        help="Files, directories, globs, or '!exclude' globs",
    )
    parser.add_argument(
        "-x",
        "--exclude",
        action="append",
        default=[],
        metavar="PATTERN",
        help="Exclude folder or file glob (repeatable)",
    )
    parser.add_argument(
        "-d",
        "--dirty",
        action="store_true",
        help="Only git modified & untracked files",
    )
    parser.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="Interactive fzf file picker",
    )
    parser.add_argument(
        "-y",
        "--yazi",
        action="store_true",
        help="Interactive Yazi file/folder chooser",
    )
    parser.add_argument(
        "--print-cmd",
        action="store_true",
        help="Print selected command instead of executing (used by zsh print -z)",
    )

    ns = parser.parse_args(argv)

    exclude_globs: GlobList = [f"--glob={g}" for g in DEFAULT_IGNORES]
    for ex in ns.exclude:
        exclude_globs.extend(expand_exclude(ex))

    targets: PathList = []
    for target in ns.targets:
        match target:
            case s if s.startswith("!"):
                exclude_globs.extend(expand_exclude(s[1:]))
            case s:
                targets.append(s)

    return Config(
        targets=targets,
        exclude_globs=exclude_globs,
        dirty=ns.dirty,
        interactive=ns.interactive,
        yazi=ns.yazi,
        print_cmd=ns.print_cmd,
    )


def run_lines(cmd: Sequence[str]) -> list[str]:
    """Run a command and return non-empty stdout lines."""
    res = subprocess.run(cmd, capture_output=True, text=True, check=False)
    return [line.removeprefix("./") for line in res.stdout.splitlines() if line]


def resolve_candidate_files(targets: PathList, exclude_globs: GlobList) -> PathList:
    """Resolve any mix of directories, explicit files, and globs while honoring .gitignore and -x."""
    if not targets:
        return run_lines(
            ["rg", "--files", "--hidden", "--sort", "path", *exclude_globs]
        )

    include_globs: GlobList = []
    dirs: PathList = []
    explicit_files: set[str] = set()

    for raw in targets:
        norm = normalize_rel(raw)
        if is_glob(norm):
            include_globs.extend(expand_include_glob(norm))
        else:
            p = Path(norm)
            if p.is_dir():
                dirs.append(norm)
            elif p.is_file():
                explicit_files.add(norm)
            else:
                # Fallback in case of non-existent path or partial pattern
                include_globs.extend(expand_include_glob(norm))

    matched: set[str] = set()

    # 1. Resolve all glob patterns (union of include globs, filtered by exclude_globs)
    if include_globs:
        matched.update(
            run_lines(
                [
                    "rg",
                    "--files",
                    "--hidden",
                    "--sort",
                    "path",
                    *include_globs,
                    *exclude_globs,
                ]
            )
        )

    # 2. Resolve directory targets
    if dirs:
        matched.update(
            run_lines(
                [
                    "rg",
                    "--files",
                    "--hidden",
                    "--sort",
                    "path",
                    *exclude_globs,
                    "--",
                    *dirs,
                ]
            )
        )

    # 3. Validate explicit files against repo-wide allowed files so .gitignore and -x still apply
    if explicit_files:
        allowed_all = set(
            run_lines(["rg", "--files", "--hidden", "--sort", "path", *exclude_globs])
        )
        matched.update(explicit_files & allowed_all)

    return sorted(matched)


def pick_with_fzf(cfg: Config) -> PathList:
    all_files = resolve_candidate_files(cfg.targets, cfg.exclude_globs)
    if not all_files:
        return []

    preview = "bat --color=always {} 2>/dev/null || cat {}"
    proc = subprocess.run(
        ["fzf", "-m", "--preview", preview],
        input="\n".join(all_files),
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )
    return [line for line in proc.stdout.splitlines() if line]


def pick_with_yazi(cfg: Config) -> PathList:
    with tempfile.NamedTemporaryFile(prefix="yazi-chooser.", delete=False) as tmp:
        tmp_path = Path(tmp.name)

    try:
        plain_paths = [normalize_rel(t) for t in cfg.targets if not is_glob(t)]
        subprocess.run(
            ["yazi", f"--chooser-file={tmp_path}", *plain_paths], check=False
        )
        if not tmp_path.exists() or tmp_path.stat().st_size == 0:
            return []
        raw_picked = [
            line for line in tmp_path.read_text(encoding="utf-8").splitlines() if line
        ]
        return [normalize_rel(p) for p in raw_picked]
    finally:
        tmp_path.unlink(missing_ok=True)


def collect_files(cfg: Config, target_paths: PathList) -> PathList:
    """Return matched non-empty text files while strictly respecting .gitignore and -x."""
    candidates = resolve_candidate_files(target_paths, cfg.exclude_globs)
    if not candidates:
        return []

    if cfg.dirty:
        dirty_files = set(
            run_lines(["git", "ls-files", "-m", "-o", "--exclude-standard"])
        )
        candidates = [f for f in candidates if f in dirty_files]
        if not candidates:
            return []

    # Filter to non-empty, non-binary text files via ripgrep '^'
    rg_content_cmd = [
        "rg",
        "-l",
        "--hidden",
        "--sort",
        "path",
        "^",
        "--",
        *candidates,
    ]
    return run_lines(rg_content_cmd)


def dump_output(files: PathList) -> None:
    out = sys.stdout
    for filepath in files:
        path = Path(filepath)
        out.write(f'<file path="{filepath}">\n')
        out.flush()
        try:
            with path.open("rb") as f:
                shutil.copyfileobj(f, sys.stdout.buffer)
            if path.stat().st_size > 0:
                with path.open("rb") as f:
                    f.seek(-1, os.SEEK_END)
                    if f.read(1) != b"\n":
                        out.write("\n")
        except OSError as exc:
            sys.stderr.write(f"Error reading {filepath}: {exc}\n")
        out.write("</file>\n\n")


def main() -> int:
    cfg = parse_args()

    if cfg.interactive or cfg.yazi:
        picked = pick_with_yazi(cfg) if cfg.yazi else pick_with_fzf(cfg)
        if not picked:
            return 1
        if cfg.print_cmd:
            print(f"catai {shlex.join(picked)}")
            return 0
        files = collect_files(cfg, picked)
    else:
        files = collect_files(cfg, cfg.targets)

    if not files:
        msg = (
            "No dirty or untracked files found."
            if cfg.dirty
            else "No matching text files found."
        )
        sys.stderr.write(f"{msg}\n")
        return 1

    dump_output(files)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
