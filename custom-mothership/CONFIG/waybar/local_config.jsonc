{
    "network": {
        "interface": "wlan0",
        "format-disabled": " Disabled",
        "format-wifi": " {bandwidthDownBits:>} 󰶡 {bandwidthUpBits:>} 󰶣 ({signalStrength}%)",
        "tooltip-format-wifi": "{essid}",
        "format-ethernet": "󰈀 {bandwidthDownBits:>} 󰶡 {bandwidthUpBits:>} 󰶣",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "format-disconnected": " Disconnected",
        "on-click": "footclient --app-id floating_shell --window-size-chars 60x45 -e nmtui",
        "interval": 2
    },
    "temperature": {
        "hwmon-name": "k10temp",
        "input-filename": "temp1_input"
    },
    "disk#hdd1": {
        "path": "/mnt/hdd1",
        "interval": 30,
        "format": "  /mnt/hdd1 {specific_free:0.0f} of {specific_total:0.0f} GB free",
        "unit": "GB",
        "states": { "warning": 85, "critical": 95 },
        "on-click": "swaymsg exec 'footclient --app-id floating_shell --window-size-chars 150x45 gdu -d'"
    },
    "custom/nvidia": {
      "exec": "nvidia-smi --query-gpu=utilization.gpu,memory.used,temperature.gpu --format=csv,nounits,noheader | awk -F', ' '{printf \"%d%% %dMB %.0f°C\\n\", $1, $2, $3}'",
      "format": "󰓅  {}",
      "on-click": "swaymsg exec 'footclient --app-id floating_shell --window-size-chars 150x45 watch nvidia-smi'",
      "interval": 1
    },
    "modules-right": [
        "privacy",
        "idle_inhibitor",
        "cpu",
        "temperature",
        "memory",
        "custom/nvidia",
        "disk#root",
        "disk#hdd1",
        "backlight",
        "pulseaudio",
        "battery",
        "clock",
        "tray",
        "custom/notification",
        "custom/power",
    ]
}
